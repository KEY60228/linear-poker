// Copy to wrangler.jsonc and fill in your own resource IDs.
// See the Setup section in README.md for the commands that create each resource.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linear-poker",
  "main": "src/worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linear_poker_db",
      "database_id": "REPLACE_ME_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "REPLACE_ME_WITH_TOKENS_KV_NAMESPACE_ID"
    },
    {
      "binding": "LINEAR_CACHE",
      "id": "REPLACE_ME_WITH_LINEAR_CACHE_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    // Daily reminder. Cron runs in UTC — adjust to your timezone.
    // Default: 06:00 UTC = 15:00 JST.
    "crons": ["0 6 * * *"]
  },
  "vars": {
    // Issue label that identifies the StoryPoint Issue in each project.
    "STORY_POINT_LABEL_NAME": "StoryPointIssue"
  }
}
